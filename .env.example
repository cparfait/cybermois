# =============================================================================
#  Cybermois - modele de configuration
#
#  Ce fichier ne sert qu'a l'AMORCAGE. Une fois l'application demarree, la
#  plupart de ces reglages se modifient dans Administration > Configuration, et
#  les valeurs saisies la-bas prennent le pas sur celles d'ici.
#
#  Restent pilotes UNIQUEMENT par l'environnement, parce qu'ils sont lus avant
#  que la base ne soit ouverte, ou qu'ils decrivent le deploiement et non la
#  campagne :
#    ENV_FILE, DB_FILE, PORT, NODE_ENV, SESSION_SECRET,
#    ADMIN_LOCAL_LOGIN, ADMIN_LOCAL_MOT_DE_PASSE,
#    LDAP_CA_FILE, TIMEZONE, PROXY_DE_CONFIANCE, DEMO_MOT_DE_PASSE,
#    RETENTION_JOURNAL_JOURS, RETENTION_RESULTATS_JOURS, RETENTION_PREUVES_JOURS
#
#  Les valeurs d'exemple ci-dessous sont NEUTRES et volontairement fausses.
#  Les valeurs reelles de la collectivite se conservent hors du depot.
# =============================================================================

# ---------- Serveur ----------
PORT=3000

# NODE_ENV n'est PAS defini ici, et c'est voulu.
#
#   - Demonstration / developpement : "cp .env.example .env" puis "npm start".
#     Sans NODE_ENV, l'application demarre en mode developpement, ce qui est la
#     seule facon de faire tourner l'annuaire simule (LDAP_URL=demo). Le mode
#     demonstration refuse de demarrer en production.
#   - Production : la valeur est fixee par l'image Docker (ENV NODE_ENV=production)
#     et par les piles docker-compose. Ne l'ecrivez ici que si vous lancez le
#     serveur a la main hors conteneur, avec NODE_ENV=production.
#
# Attention : une ligne NODE_ENV presente dans ce fichier est chargee par
# "env_file: .env" et l'emporte sur le ENV de l'image.
#NODE_ENV=production

# Obligatoire. 32 caracteres aleatoires minimum, propres a l'installation.
#
# En NODE_ENV=production, l'application REFUSE DE DEMARRER si ce secret est
# absent, s'il vaut encore la valeur de developpement par defaut, ou s'il fait
# moins de 32 caracteres.
#
# ATTENTION : cette valeur chiffre aussi les mots de passe du compte de service
# Active Directory et du relais SMTP enregistres depuis la page de
# configuration. La changer les rend illisibles : il faudra les ressaisir.
# Ne la commitez jamais.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# URL reellement vue par les agents : elle alimente les liens des mails et
# conditionne le drapeau "secure" du cookie de session. En https, l'application
# emet en plus l'en-tete Strict-Transport-Security.
PUBLIC_URL=https://cybermois.exemple.fr

# Emplacement de la base SQLite. Defaut : ./data/cybermois.db a partir du
# repertoire de travail. A definir pour separer deux instances qui partagent un
# meme volume (voir docker-compose.recette.yml).
#DB_FILE=/app/data/cybermois.db

# Chemin d'un autre fichier .env a charger. Defaut : ./.env. Sert surtout a
# lancer un jeu de reglages alternatif sans toucher au fichier principal.
#ENV_FILE=/app/.env.recette

# Adresses ou plages CIDR du reverse proxy, separees par des virgules.
# VIDE = les en-tetes X-Forwarded-For / X-Forwarded-Proto ne sont PAS pris en
# compte, d'ou qu'ils viennent. Renseignez l'adresse de Nginx Proxy Manager pour
# que le journal porte l'IP reelle des agents plutot que celle du proxy.
# N'y mettez que des adresses que vous controlez : une plage trop large permet a
# n'importe qui de se choisir une adresse dans le journal.
#PROXY_DE_CONFIANCE=172.18.0.0/16

# ---------- Conservation des donnees ----------
# Une purge automatique applique les durees annoncees dans les mentions legales.
# Journal applicatif : 180 jours (6 mois).
RETENTION_JOURNAL_JOURS=180
# Participations et reponses nominatives : 456 jours, soit la fin de l'annee
# civile suivant la campagne.
RETENTION_RESULTATS_JOURS=456
# Preuves de participation AGREGEES (combien de defis par agent et par annee),
# conservees pour l'audit SSI : 1095 jours, soit 3 ans. Elles sont constituees
# au moment ou les resultats detailles sont effaces.
RETENTION_PREUVES_JOURS=1095
# Modifier ces trois valeurs sans en avertir la DPO fait diverger le traitement
# reel des durees annoncees dans les mentions legales.

# ---------- Compte administrateur local ----------
# Independant de l'annuaire : il permet de saisir la configuration Active
# Directory avant qu'elle ne fonctionne, et de reprendre la main si l'annuaire
# devient injoignable.
# Si le mot de passe est laisse vide, l'application en genere un au premier
# demarrage et l'affiche UNE SEULE FOIS dans les journaux du conteneur.
ADMIN_LOCAL_LOGIN=admin
ADMIN_LOCAL_MOT_DE_PASSE=

# ---------- Active Directory ----------
# Mettre "demo" pour un annuaire simule (demonstration, sans AD).
LDAP_URL=ldaps://dc01.exemple.lan:636

# Compte de service en lecture seule, dedie a cette application. Le DN complet
# et la forme utilisateur@domaine sont tous deux acceptes par l'Active Directory.
LDAP_BIND_DN=ad.cybermois@exemple.lan
LDAP_BIND_PASSWORD=

LDAP_BASE_DN=DC=exemple,DC=lan
LDAP_USER_FILTER=(&(objectClass=user)(objectCategory=person)(sAMAccountName={{login}}))

# Restreindre la campagne aux membres d'un groupe. Vide = tous les agents.
LDAP_REQUIRED_GROUP=

# Membres autorises au back-office. Nom court ou DN complet.
LDAP_ADMIN_GROUP=GG-Cybermois-Admins

# Certificat de l'autorite interne, au choix :
#   - en base64 sur une ligne (recommande, aucun fichier a monter) :
#     [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\temp\ca.cer"))
LDAP_CA_BASE64=
#   - ou par un fichier monte dans le conteneur. LE CHEMIN DEPEND DE LA PILE :
#       docker-compose.yml       monte ./certs sur /app/certs
#                                -> LDAP_CA_FILE=/app/certs/ca-interne.crt
#       docker-compose.portainer.yml monte le dossier d'AC de l'hote sur /certs
#                                -> LDAP_CA_FILE=/certs/ca.pem
#     Dans les deux cas, adaptez le nom de fichier au contenu reel du dossier.
LDAP_CA_FILE=/app/certs/ca-interne.crt

# A laisser a true. Le passer a false chiffre la liaison sans l'authentifier.
LDAP_TLS_REJECT_UNAUTHORIZED=true

# Autorise ldap:// non chiffre en production. Sans cette variable, un serveur en
# ldap:// demarre quand meme mais REFUSE les authentifications d'agents, avec un
# avertissement dans les journaux. Les mots de passe des agents circuleraient en
# clair : a n'activer que temporairement, en recette.
LDAP_AUTORISER_NON_CHIFFRE=false

# ---------- Rattachement au service ----------
# ou   = deduit de l'OU du DN (recommande)
# attr = lu dans un attribut AD
SERVICE_SOURCE=ou
SERVICE_ATTRIBUTE=department
# 1 = l'OU contenant directement l'agent.
# Les sous-OU se traitent ensuite par regroupement, dans le back-office.
SERVICE_OU_DEPTH=1

# Exiger une adresse mail pour retenir un compte lors de la synchronisation
# depuis l'annuaire. Defaut : true. Un agent sans adresse ne recoit ni lancement
# ni relance, mais pese sur le taux de participation de son service.
SYNC_EXIGER_EMAIL=true

# ---------- Administration ----------
# Complement au groupe AD ci-dessus, utile pour un depannage ponctuel.
ADMIN_LOGINS=c.parfait

# ---------- Messagerie ----------
# Direct Send Microsoft 365 : aucune authentification, le serveur se lit dans
# l'enregistrement MX du domaine (nslookup -type=mx votredomaine.fr).
SMTP_HOST=votredomaine-fr.mail.protection.outlook.com
SMTP_PORT=25
# false + port 25 : la liaison est elevee en TLS par STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Cybermois <cybermois@exemple.fr>"

# Destinataire du mail de resultats du vendredi.
MAIL_GROUPE_DIFFUSION=
MAIL_COPIE=

# Interrupteur general des envois PLANIFIES. A laisser a false jusqu'a la fin
# de la recette : l'envoi a la main depuis l'onglet Mails reste possible.
MAIL_ENVOI_ACTIF=false
# Interrupteur de chaque mail automatique (reglables aussi dans l'onglet Mails).
MAIL_AUTO_OUVERTURE=true
MAIL_AUTO_ANNONCE=true
MAIL_AUTO_RELANCE=true
MAIL_AUTO_RESULTATS=true

# ---------- Planification ----------
TIMEZONE=Europe/Paris
# Mail d'ouverture a chaque agent, le jour du premier defi, une seule fois.
# Plusieurs passages : ceux qui suivent rattrapent un serveur arrete a 8 h.
CRON_OUVERTURE=0 8-17 * * *
# Annonce des defis de la semaine, les lundis suivants, une fois par semaine.
CRON_ANNONCE=0 8-17 * * 1
# Relance des agents qui n'ont pas fait les defis des sept derniers jours.
CRON_RELANCE=0 9 * * 3
CRON_RESULTATS=0 16 * * 5

# ---------- Campagne ----------
CAMPAGNE_DEBUT=2026-10-05
CAMPAGNE_FIN=2026-10-31

# ---------- Presentation et contenus ----------
# Adresse de la deleguee a la protection des donnees, citee dans les mentions
# legales. Defaut : dpo@chatillon92.fr.
CONTACT_DPO=dpo@exemple.fr

# Nombre de cartes de defi par ligne. Defaut : 2. Quatre cartes sur une ligne se
# lisent mal sur un ecran de bureau.
DEFIS_PAR_LIGNE=2

# Hebergeurs autorises a fournir une video d'introduction, separes par des
# virgules. La liste alimente la politique de securite de contenu : un domaine
# absent d'ici verra son lecteur bloque par le navigateur.
# Defaut si la variable est absente :
#   www.youtube-nocookie.com,www.dailymotion.com,geo.dailymotion.com
# Definir la variable REMPLACE cette liste, elle ne s'y ajoute pas.
#VIDEO_DOMAINES=www.youtube-nocookie.com,www.dailymotion.com,geo.dailymotion.com

# ---------- Demonstration seulement ----------
# Mot de passe commun des quinze comptes fictifs de l'annuaire simule
# (LDAP_URL=demo). Defaut : demo2026. Sans effet hors mode demonstration.
#DEMO_MOT_DE_PASSE=demo2026
