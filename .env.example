# ---------- Serveur ----------
PORT=3000
NODE_ENV=production
SESSION_SECRET=changez-moi-32-caracteres-minimum-aleatoire
PUBLIC_URL=https://cybermois.ville.local

# ---------- LDAPS / Active Directory ----------
LDAP_URL=ldaps://dc01.ville.local:636
# Compte de service AD en lecture seule
LDAP_BIND_DN=CN=svc-cybermois,OU=Comptes de service,DC=ville,DC=local
LDAP_BIND_PASSWORD=
# Racine de recherche des utilisateurs
LDAP_BASE_DN=DC=ville,DC=local
# Filtre de recherche : {{login}} est remplace par la saisie de l'agent
LDAP_USER_FILTER=(&(objectClass=user)(objectCategory=person)(sAMAccountName={{login}}))
# Restreindre aux membres d'un groupe (optionnel, laisser vide pour tout le monde)
LDAP_REQUIRED_GROUP=
# Certificat de l'AC interne qui signe le certificat LDAPS des DC
LDAP_CA_FILE=/app/certs/ca-interne.crt
# Mettre a false UNIQUEMENT en recette
LDAP_TLS_REJECT_UNAUTHORIZED=true

# ---------- Rattachement au service ----------
# ou   = deduit de l'OU du DN de l'utilisateur (recommande)
# attr = lu dans un attribut AD (department / physicalDeliveryOfficeName)
SERVICE_SOURCE=ou
SERVICE_ATTRIBUTE=department
# Profondeur de l'OU a retenir : 1 = OU la plus proche de l'utilisateur
SERVICE_OU_DEPTH=1

# ---------- Administration ----------
# Logins AD autorises a acceder au back-office, separes par des virgules
ADMIN_LOGINS=c.parfait

# ---------- SMTP (relances et resultats) ----------
SMTP_HOST=smtp.ville.local
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Cybermois <cybermois@ville.fr>"
# Destinataire des mails de resultats hebdomadaires (groupe de distribution)
MAIL_GROUPE_DIFFUSION=tous-agents@ville.fr
# Copie systematique (DPO / DSI)
MAIL_COPIE=

# ---------- Planification ----------
TIMEZONE=Europe/Paris
# Relance des non-joueurs : mercredi 09h00
CRON_RELANCE=0 9 * * 3
# Resultats hebdomadaires : vendredi 16h00
CRON_RESULTATS=0 16 * * 5
# Mettre a false pour desactiver tout envoi automatique (recette)
MAIL_ENVOI_ACTIF=true

# ---------- Campagne ----------
# Date d'ouverture de la semaine 1 (lundi). Les semaines suivantes s'ouvrent a +7j.
CAMPAGNE_DEBUT=2026-10-05
CAMPAGNE_FIN=2026-10-31
